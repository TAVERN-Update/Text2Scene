--- !u!114 &3169022222729764810
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 3613983469491252987}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b><color=\"yellow\">Scene Composition Instructions</color= \"yellow\"></b>\nIit\u2019s
    time to scale and place your newly generated asset in the room!\n\nPlease follow
    these steps:\n\n<b><color=\"yellow\">1. Generate Scaling</color= \"yellow\"></b>\nStart
    by clicking the \u201CGenerate Scaling\u201D button. This step computes the relative
    size of each object based on its proportions compared to the others.\nYou can
    press this button multiple times if you're not satisfied with the scaling result.\n\n<b><color=\"yellow\">2.
    Place Next Objects</color= \"yellow\"></b>\nOnce scaling has been generated (at
    least once), click \u201CPlace Next Objects\u201D to begin placing the items
    into the scene.\nObjects will be positioned one batch at a time, so you can proceed
    gradually.\n\n<b><color=\"yellow\">Refine (optional, between placements)</color=
    \"yellow\"></b>\nAfter each placement step, you may click \u201CRefine\u201D
    to adjust the objects already placed in the scene.\n\nIf you enter a suggestion
    in the text field (e.g., \"move the vase closer to the wall\"), the system will
    attempt to reposition the current objects accordingly.\n\nIf you leave the input
    field empty, the system will automatically attempt a refinement based on its
    own reasoning.\n\n<b><color=\"yellow\">Repeat until complete</color= \"yellow\"></b>\nContinue
    alternating between \u201CPlace Next Objects\u201D and \u201CRefine\u201D until
    all objects have been placed and adjusted.\n\n                                                              
    <b>PRESS X TO CLOSE</b>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
